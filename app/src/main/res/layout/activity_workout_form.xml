<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarWorkoutForm"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/etWorkoutTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Workout Title *"
                android:background="@android:drawable/edit_text"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Activity Type: *"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spnWorkoutActivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:drawable/btn_dropdown"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvWorkoutDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Planned Date (YYYY-MM-DD) *"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:clickable="true"
                android:focusable="false"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/etWorkoutDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Target Duration (mins) *"
                android:inputType="number"
                android:background="@android:drawable/edit_text"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/etWorkoutNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Notes (Optional)"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:background="@android:drawable/edit_text"
                android:padding="12dp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnSaveWorkout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Plan"
                android:backgroundTint="@color/primary"
                android:textColor="@color/white"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnDeleteWorkout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delete Plan"
                android:backgroundTint="@android:color/holo_red_dark"
                android:textColor="@color/white"
                android:padding="12dp"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>