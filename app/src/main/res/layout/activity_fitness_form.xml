<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarFitnessForm"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Activity Type: *"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spnActivityType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:drawable/btn_dropdown"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvFitnessDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Date (YYYY-MM-DD) *"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:clickable="true"
                android:focusable="false"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:baselineAligned="false">

                <EditText
                    android:id="@+id/etDuration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Duration (mins) *"
                    android:inputType="number"
                    android:background="@android:drawable/edit_text"
                    android:padding="12dp"
                    android:layout_marginEnd="4dp" />

                <EditText
                    android:id="@+id/etCalories"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Calories Burned"
                    android:inputType="numberDecimal"
                    android:background="@android:drawable/edit_text"
                    android:padding="12dp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Notes (Optional)"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:background="@android:drawable/edit_text"
                android:padding="12dp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnSaveFitness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Record"
                android:backgroundTint="@color/primary"
                android:textColor="@color/white"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnDeleteFitness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delete Record"
                android:backgroundTint="@android:color/holo_red_dark"
                android:textColor="@color/white"
                android:padding="12dp"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>